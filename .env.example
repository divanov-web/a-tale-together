# Копировать в .env и заполнить. Дефолты для необязательных см. internal/config.

# Telegram: токен тестового бота от BotFather (обязателен для запуска бота)
TELEGRAM_BOT_TOKEN=

# PostgreSQL 16 локально (роль и базы по docs/dev/environment.md)
DATABASE_URL=postgres://tale:tale@localhost:5432/tale?sslmode=disable
DATABASE_URL_TEST=postgres://tale:tale@localhost:5432/tale_test?sslmode=disable

# LLM: профили хранятся в БД (docs/llm/providers.md); здесь только секреты и пути провайдеров
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_WORKDIR=/home/divanov/.local/share/tale-llm

# Владелец бота: Telegram ID (видно в /me); только ему доступны команды /llm
BOT_OWNER_ID=

# Приложение
APP_ENV=dev
LOG_LEVEL=debug
MIGRATE_ON_START=false
# Журнал чатов для разбора ошибок ИИ (docs/dev/chat-logs.md): папка на чат, файл на день; пусто — выключен
CHAT_LOG_DIR=logs/chats
CHAT_LOG_RETENTION_DAYS=30
# Фоновые циклы: период планировщика раундов и воркера outbox
SCHEDULER_TICK=10s
OUTBOX_TICK=3s
